# Required for LLM summaries and LLM-backed Q&A. Leave empty to use the safe fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=90
MAX_TRANSCRIPT_CHARS=24000
MAX_CONCURRENT_ANALYSES=2
MAX_QUESTION_CHARS=4000
MAX_VIDEO_INPUT_CHARS=500
MAX_COVER_BYTES=5242880
# Optional Bearer Token for protecting Web API endpoints. Leave empty for local-only use.
WEB_AUTH_TOKEN=
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=20
JOB_TTL_SECONDS=86400
MAX_JOBS=100
MAX_HISTORY_TURNS=24

# Optional Bilibili login cookies. Some CC subtitles are only visible when logged in.
BILI_SESSDATA=
BILI_BILI_JCT=
BILI_BUVID3=

# ASR is deliberately off by default. Install: pip install -e ".[asr]"
ASR_ENABLED=false
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_CACHE_DIR=.bili-agent/audio
MULTIMODAL_ENABLED=false
MULTIMODAL_MAX_FRAMES=6
MEDIA_CACHE_DIR=.bili-agent/media
# Optional separate model for image inputs; defaults to LLM_MODEL.
VISION_MODEL=
